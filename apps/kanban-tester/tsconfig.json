{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@formstr/kanban-sdk": ["../../packages/kanban-sdk/src/index.ts"],
      "@formstr/signer": ["../../packages/signer/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
