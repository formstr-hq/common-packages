{
  "name": "@formstr/mailstr-sdk",
  "version": "0.1.0",
  "description": "Headless TypeScript SDK for Mailstr — Nostr-native email: identity, NIP-98 auth, mailbox claiming, DM-relay setup, and kind-1059 gift-wrap inbox reading",
  "license": "MIT",
  "author": "Abhay <toabhayraizada@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/formstr-hq/common-packages/tree/main/packages/mailstr-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formstr-hq/common-packages.git",
    "directory": "packages/mailstr-sdk"
  },
  "bugs": {
    "url": "https://github.com/formstr-hq/common-packages/issues"
  },
  "keywords": [
    "nostr",
    "mailstr",
    "formstr",
    "email",
    "nip-05",
    "nip-17",
    "nip-59",
    "nip-98",
    "gift-wrap",
    "kind-1059",
    "inbox",
    "lightning",
    "invoice"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "nostr-tools": "^2.23.3",
    "postal-mime": "^4.0.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}