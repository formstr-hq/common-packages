{
  "name": "@formstr/signer",
  "version": "0.2.2",
  "description": "Nostr signer with login UI for NIP-07, NIP-46, NIP-49 (ncryptsec), and NIP-55",
  "license": "MIT",
  "author": "Abhay <toabhayraizada@gmail.com>",
  "homepage": "https://github.com/formstr-hq/common-packages/tree/main/packages/signer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formstr-hq/common-packages.git",
    "directory": "packages/signer"
  },
  "bugs": {
    "url": "https://github.com/formstr-hq/common-packages/issues"
  },
  "keywords": [
    "nostr",
    "signer",
    "nip-07",
    "nip-46",
    "nip-49",
    "nip-55",
    "ncryptsec",
    "bunker",
    "nostr-connect",
    "amber",
    "formstr"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    },
    "./styles.css": "./styles/signer.css"
  },
  "files": [
    "dist",
    "styles",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "nostr-tools": "^2.7.0",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "nostr-signer-capacitor-plugin": "^0.0.5"
  },
  "peerDependenciesMeta": {
    "nostr-signer-capacitor-plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^2.0.0",
    "happy-dom": "^15.0.0",
    "nostr-signer-capacitor-plugin": "^0.0.5",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
